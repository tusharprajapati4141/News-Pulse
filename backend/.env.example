# Copy this file to .env and adjust as needed.

PORT=4000

# Path to the shared SQLite DB (same file the Python scraper writes to).
DB_PATH=../data/news_pulse.db

# Path to the python executable and the scraper script, used by POST /ingest/trigger
PYTHON_BIN=python3
SCRAPER_SCRIPT=../scraper/scraper.py

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:3000
